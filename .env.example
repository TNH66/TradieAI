# --- Supabase ---
# Found in Supabase Dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Service role key - SERVER ONLY. Never expose to the browser.
# Used only in trusted server contexts (e.g. future admin operations).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Anthropic ---
# Found at https://console.anthropic.com/settings/keys
# Used only in server-side API routes (src/app/api/**). Never exposed to the client.
ANTHROPIC_API_KEY=your-anthropic-api-key

# --- App ---
# Base URL of the deployed app, used for building shareable public quote links.
NEXT_PUBLIC_APP_URL=http://localhost:3000
